# Trades — the perimeter (Caddy 2.11): TLS termination, one hostname per deployable (BR-28 of
# 10.4), safe-by-construction request logs (BR-13, LO-009, GD-005), and — since 10.6 — the
# stage-1 privacy perimeter: basic auth on the SPA and the mail viewer, `noindex` everywhere,
# and the security-header floor on the responses the proxy generates itself.
# Derived from ai-standards/templates/deploy/Caddyfile.template — the (log-redaction) and
# (access-log) snippets are the template's, verbatim. Perimeter decisions: ADR-120 (amended
# by 10.6: the proxy-generated-response carve-out, BR-20) and ADR-124 (the stage-1 perimeter,
# BR-18, BR-21 — basic auth, noindex and the sslip.io hostname go together at the 10.9 go-live;
# the floor stays).
#
# ENV PLACEHOLDERS (substituted at parse time from docker-compose.prod.yml `environment:`):
#   {$DOMAIN}            the base hostname — `<eip-with-dashes>.sslip.io` in stage 1 (BR-15),
#                        `trades.test` in the rehearsal
#   {$CADDY_TLS_ARG}     `tls` argument: the ACME e-mail in production (which also enables
#                        Caddy's ZeroSSL fallback — every sslip.io certificate shares Let's
#                        Encrypt's rate limits with every other sslip.io user, BR-16),
#                        `internal` in the rehearsal (Caddy's local CA; the harness trusts its
#                        root explicitly — verification is never switched off, invariants.md)
#   {$BASIC_AUTH_USER}   the ONE shared operational credential of stage 1 (BR-18); the hash
#   {$BASIC_AUTH_HASH}   comes from `caddy hash-password` and lives ONLY in deploy/.env,
#                        single-quoted (BR-19). Never in this file, never in a repository.
#
# HOSTS:
#   app.{$DOMAIN}      → web:8080       the SPA — BASIC AUTH (its nginx emits CSP/HSTS/COOP/CORP)
#   api.{$DOMAIN}      → app:8000       trades-backend; /.well-known/mercure* → mercure:80 — EXEMPT
#   media.{$DOMAIN}    → media:8008     media-service — EXEMPT
#   storage.{$DOMAIN}  → storage:9000   the object store's public endpoint (presigned URLs,
#                                        public media) — EXEMPT; the ONE host whose security
#                                        headers this file sets unconditionally (BR-32 of 10.4)
#   mail.{$DOMAIN}     → mailpit:8025   the stage-1 captured-mail viewer (BR-25) — BASIC AUTH
#
# WHY api./media./storage. ARE EXEMPT (BR-18): HTTP Basic and the API's Bearer token share
# the Authorization header, so gating the API would break every SPA call and the login
# itself; the storage host serves presigned URLs; the hub lives on api. Those hosts keep their
# permanent posture (JWT, rate limits, CORS pinned to the app. origin).
#
# RULES THIS FILE MUST KEEP:
#   - Upstreams remain the sole authors of everything they serve (AS-001..AS-004, BR-15a of
#     10.4). The ONE carve-out (BR-20, ADR-120 amended): responses the PROXY GENERATES ITSELF —
#     the basic-auth 401, the 502/503 of a down upstream — carry the (security_floor) below in
#     set-if-absent form (`header ?Field`), so an upstream-emitted header ALWAYS wins. The
#     snippet is imported at site level AND inside every handle_errors: deferred `?` defaults
#     do NOT ride Caddy's error lane, and the error lane is exactly where every proxy-generated
#     response is born — the second import is load-bearing, never remove it. The storage host
#     keeps its explicit header block, which wins over a deferred default, so it still has one
#     writer per header.
#   - The error lane answers `{err.status_code} {err.status_text}` and nothing else (no
#     internals, SE-004), marked `Cache-Control: private, no-store` (AS-028) — auth-required
#     and 4xx/5xx responses are never stored by a shared cache.
#   - `X-Robots-Tag: noindex` on EVERY site (BR-18) — a robots directive, not a security header.
#   - Every site block imports (access-log): Caddy logs NOTHING about requests without an
#     explicit `log` directive. The redaction filter is imported TWICE — into the global
#     default logger (the http.log.error.* channel a 502 writes with the full request line)
#     and into every access log.
#   - Caddy trusts no upstream proxy here, so a caller's forged X-Forwarded-For is overwritten
#     with the real address before the backends see it; the backends trust only this proxy's
#     subnet (BR-30 of 10.4).
#
# VERIFY BY READING AN EMITTED LINE / THE ADAPTED JSON (scripts/checks/check-caddyfile.sh),
# never by `caddy validate` alone (the lexer trap below).

# ---- the redaction filter, applied to BOTH request-logging channels ---------
(log-redaction) {
	format filter {
		wrap json
		fields {
			# Strip the query string, KEEP the path.
			#
			# ⚠ THE LEXER TRAP — use the character class `[?]`, never the
			# backslash escape `"\\?"`. The Caddyfile lexer re-processes
			# `"\\?"` into the regex `\\?` = "an OPTIONAL literal
			# backslash", which matches the empty string at offset 0, so
			# `.*$` then eats the ENTIRE uri INCLUDING THE PATH. Verified
			# on the pinned version: `caddy validate` still prints "Valid
			# configuration" and the emitted line is `"uri": ""`. It fails
			# OPEN, silently. Prove this field by reading an emitted log
			# line, never by the validator's verdict.
			request>uri regexp "[?].*$" ""

			# ALL headers, all bodies, the TLS block, the source port.
			# Caddy cannot express a header allowlist (`rename` moves a header
			# WITHIN request>headers, so deleting the parent map takes the renamed
			# copy with it) — blanket delete is the deny-by-construction choice here.
			request>headers delete
			resp_headers delete
			request>tls delete
			request>remote_port delete

			# The caller's IP, PSEUDONYMISED AT WRITE TIME (GD-005): /24 · /48 on
			# BOTH fields Caddy emits (remote_ip AND client_ip). Anything the mask
			# cannot parse is written as `-`, never raw.
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
		}
	}
}

{
	# The DEFAULT logger — Caddy's operational output AND the http.log.error.*
	# channel. Output stays stderr (operational lines must reach `docker logs`);
	# only the FORMAT is filtered, so a 502's request line is redacted before it
	# is ever written.
	log {
		import log-redaction
	}
}

# ---- request logging, imported by EVERY site block below (LO-009) -----------
#
# A FILE ON THE caddy-logs NAMED VOLUME, not stdout: a recreate (every promotion) destroys
# the container's log; the file outlives it (DE-007). BOTH a size and a TIME ceiling:
# `roll_interval 24h` forces a roll on a quiet site so `roll_keep_for 336h` (14 days) is a
# real ceiling — it MUST match the perimeter-request-log row in pii-inventory.md (BR-21).
(access-log) {
	log {
		# Every site block shares THIS ONE writer (Caddy dedupes file writers by
		# filename): keep the roll options in this snippet only.
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 14
			roll_keep_for 336h
			roll_interval 24h
		}
		import log-redaction
	}
}

# ---- the security-header floor on PROXY-GENERATED responses (BR-20) ---------
# KHA's ADR-050 carve-out, copied: HSTS byte-identical to the upstreams; the CSP is the
# API's minimal deny policy (never the SPA's rich policy); CORP `same-site` (the
# non-HTML precedent). `?` = set only where the header is absent — an upstream header
# always wins; on normal upstream traffic this is a no-op by construction (every
# upstream emits the full set), on a 401 / 502 / 503 it is the only writer.
# `form-action` and `base-uri` never fall back to default-src, so the deny policy names them
# (ZAP 10055 on the first production DAST). The two deletions strip the stack fingerprint
# (`X-Powered-By: PHP/x.y.z` from the backend image, `Server` from nginx / Caddy) on every
# site; a `-Field` deletion is deferred by Caddy, so it also reaches upstream responses.
(security_floor) {
	header ?Strict-Transport-Security "max-age=63072000; includeSubDomains"
	header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"
	header -X-Powered-By
	header -Server
	header ?X-Content-Type-Options "nosniff"
	header ?Referrer-Policy "strict-origin-when-cross-origin"
	header ?Cross-Origin-Opener-Policy "same-origin"
	header ?Cross-Origin-Resource-Policy "same-site"
}

# ---- the error lane, imported by EVERY site block (BR-20, AS-028, SE-004) ----
# handle_errors is where the basic-auth 401 and a down upstream's 502 / 503 are
# written. The floor import here is LOAD-BEARING (see the header: deferred `?`
# defaults skip this lane without it). `respond` preserves the error status
# verbatim and the body is the bare status line — no internals. Cache-Control is
# an immediate set (no `?`): nothing upstream ever writes this lane, and an error
# response must be uncacheable unconditionally — error-lane ONLY, never moved
# into (security_floor), which also rides normal upstream traffic at site level.
# WWW-Authenticate is set by basic_auth before the error propagates, so the 401
# challenge keeps working.
(error_lane) {
	handle_errors {
		import security_floor
		header Cache-Control "private, no-store"
		respond "{err.status_code} {err.status_text}"
	}
}

# ---- the SPA — behind basic auth (BR-18) -----------------------------------
app.{$DOMAIN} {
	tls {$CADDY_TLS_ARG}
	encode zstd gzip
	import access-log
	import security_floor
	header X-Robots-Tag "noindex"
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	reverse_proxy web:8080
	import error_lane
}

# ---- the backend + the Mercure hub on the same host — EXEMPT -----------------
# The hub lives under the API host so its subscriber cookie `mercureAuthorization`
# (host-only, Path=/.well-known/mercure) never has to be widened (BR-28 of 10.4). The
# versioned /api/v1/school-link/ routes and the unversioned first-party routes take the
# same path through this block and are headed identically (BR-15 of 10.4).
api.{$DOMAIN} {
	tls {$CADDY_TLS_ARG}
	encode zstd gzip
	import access-log
	import security_floor
	header X-Robots-Tag "noindex"

	handle /.well-known/mercure* {
		# SSE: no buffering, no compression on the stream — flush as the hub writes.
		reverse_proxy mercure:80 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy app:8000
	}

	import error_lane
}

# ---- media-service — EXEMPT --------------------------------------------------
media.{$DOMAIN} {
	tls {$CADDY_TLS_ARG}
	import access-log
	import security_floor
	header X-Robots-Tag "noindex"
	reverse_proxy media:8008
	import error_lane
}

# ---- the object store's public endpoint — EXEMPT (BR-32 of 10.4) -------------
# MinIO cannot emit these, so the proxy is their ONE writer on this host. `defer` applies
# them after the upstream response so an upstream header of the same name is replaced,
# never duplicated (exactly once). The explicit set below wins over the floor's deferred
# `?` defaults, so each header keeps one writer. No CSP (no HTML is served here), no COEP.
#
# THE STORAGE FILTER (minio-storage-perimeter-hardening, ADR-135): MinIO RELEASE.2025-09-07 is
# the last community release and will never be patched (ADR-126). The `route` below is what
# decides whether a request reaches it, in WRITTEN order (a route runs its directives as
# written, not in the directive-order table):
#   1. NAMED REFUSALS → `error 403` (BR-1, BR-2, BR-5). Each is born in the error lane below:
#      body `403 Forbidden`, the six floor headers, `Cache-Control: private, no-store`, no
#      upstream connection (BR-8). Header NAMES are matched case-insensitively by Caddy;
#      VALUES with `(?i)` regexps. `header_regexp` and `header` check EVERY line of a repeated
#      header (measured on the pinned image: a second `X-Amz-Content-Sha256: STREAMING-…` line
#      after an `UNSIGNED-PAYLOAD` one is refused).
#   2. THE POSITIVE ALLOWLIST → `error 403` when it does not hold (BR-3, BR-4, BR-6). ONE CEL
#      expression, negated, over the method and the RAW request URI (`{http.request.uri}`:
#      path + query exactly as sent — nothing is decoded first, so an encoded form can only
#      fail it). Path: an object key of `media-public` / `media-private` in the shapes
#      media-service mints (`AssetObjectKey`: `{visibility}/{owner}/{asset}/{leaf}`;
#      `AssetPublicAliasKey`: `public/{asset}/{leaf}`, ADR-123) — no `%`, no `..`, no empty
#      segment can match. Query: absent, or `&`-separated pairs that are each a presigned
#      SigV4 key with a value in `[A-Za-z0-9%._~-]`, `X-Amz-Content-Sha256=UNSIGNED-PAYLOAD`
#      (the ONLY content hash a presigned URL carries — every `STREAMING-*` form fails here)
#      or `x-amz-meta-asset-id=<uuid>` (the SDK hoists the signed metadata into the query).
#      Key names are case-insensitive, a repeated key is checked each time, a `;`, a bare key
#      or any sub-resource key (`uploads`, `select`, `acl`, `delete`, `versionId`, …) fails.
#      The bucket names are LITERAL here — renaming a bucket is a change to this file in the
#      same commit (spec § Open Questions).
#   3. THE FAMILY STRIP (`request_header -Family*`, BR-2 refined): Caddy cannot match a header
#      NAME by prefix (measured — `header X-Minio-* *` never matches), so the named members of
#      each family are refused above and whatever else carries one of these prefixes is
#      removed before the proxy — MinIO never receives it either way.
#   4. `reverse_proxy storage:9000`, unchanged.
# The named-refusal lists were checked against the pinned release's header constants — read
# out of the pinned binary's string table (`strings` over `/usr/bin/minio` of
# RELEASE.2025-09-07T16-13-09Z, 2026-10-18), since the source tree is not in the image. Every
# name the spec lists is present there, and these source / replication / internal names
# found there were ADDED (the spec's "the list only ever grows"):
# `X-Minio-Source-Replication-Retention-Timestamp`, `X-Minio-Source-Replication-Legalhold-Timestamp`,
# `X-Minio-Source-Replication-Tagging-Timestamp`, `X-Minio-Replication-Reset-Status`,
# `X-Minio-Replication-Ssec-Crc`, `X-Minio-Replication-Delete-Status`,
# `X-Minio-Replication-Deletemarker-Status`, `X-Minio-Replication-Encrypted-Multipart`,
# `X-Minio-Replication-Ready`, `X-Minio-Check-Replication-Ready`, `X-Minio-Force-Create`,
# `X-Minio-Extract`, `X-Minio-Fanout-List`, `X-Amz-Server-Side-Encryption-Bucket-Key-Enabled`;
# the `X-Minio-Internal-*` family (thirty-odd names) and the `X-Amz-Copy-Source-*` conditions
# ride the family strip. The legitimate flow (spec BR-7, evidence § 1) sends NONE of these, and
# every recorded shape passes the allowlist unchanged (evidence § 5).
# ADDED by the second review pass (the list only ever grows): the generic S3 write-side headers
# that a holder of a valid presigned URL could otherwise hand to the store — `X-Amz-Tagging`,
# `X-Amz-Tagging-Directive`, `X-Amz-Acl`, the five `X-Amz-Grant-*` (`-Read`, `-Write`,
# `-Read-Acp`, `-Write-Acp`, `-Full-Control`), `X-Amz-Storage-Class`,
# `X-Amz-Website-Redirect-Location`, `X-Amz-Security-Token` (an STS session token — the
# identities are plain users, never STS, ADR-135) and `X-Amz-Bypass-Governance-Retention`;
# every name read from the same string table, and the `X-Amz-Grant-*` / `X-Amz-Tagging*` families
# stripped below them. No recorded shape sends any of them: the SDK signs exactly
# `Content-Type` + `x-amz-meta-asset-id` on a PUT (`S3ObjectStorage::presignPutUrl`), the SPA and
# the seed lane send the `upload_headers` list verbatim, a GET / HEAD sends none (evidence § 1).
# The development stack has no perimeter in front of MinIO and gets no filter (BR-9).
# scripts/checks/check-caddyfile.sh reads this route back out of the adapted JSON (check 11).
storage.{$DOMAIN} {
	tls {$CADDY_TLS_ARG}
	import access-log
	import security_floor
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-Robots-Tag "noindex"
		Referrer-Policy "strict-origin-when-cross-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		defer
	}
	route {
		# 1. named refusals — the header-signed S3 API never crosses the perimeter (BR-5)
		@refuse_authorization header Authorization *
		error @refuse_authorization 403
		# 1. named refusals — the unsigned-trailer / streaming upload path, CVE-2026-41145 and
		#    CVE-2026-40344's precondition (BR-1)
		@refuse_streaming_sha header_regexp X-Amz-Content-Sha256 (?i)^STREAMING-
		error @refuse_streaming_sha 403
		@refuse_trailer header X-Amz-Trailer *
		error @refuse_trailer 403
		@refuse_decoded_length header X-Amz-Decoded-Content-Length *
		error @refuse_decoded_length 403
		@refuse_aws_chunked header_regexp Content-Encoding (?i)aws-chunked
		error @refuse_aws_chunked 403
		# 1. named refusals — the Snowball auto-extract handler, CVE-2026-40344 (BR-2)
		@refuse_snowball header X-Amz-Meta-Snowball-Auto-Extract *
		error @refuse_snowball 403
		@refuse_snowball_prefix header X-Amz-Meta-Minio-Snowball-Prefix *
		error @refuse_snowball_prefix 403
		@refuse_snowball_ignore_dirs header X-Amz-Meta-Minio-Snowball-Ignore-Dirs *
		error @refuse_snowball_ignore_dirs 403
		@refuse_snowball_ignore_errors header X-Amz-Meta-Minio-Snowball-Ignore-Errors *
		error @refuse_snowball_ignore_errors 403
		# 1. named refusals — server-side encryption, copy, replication and object-lock
		#    metadata injection, the CVE-2026-34204 class (BR-2)
		@refuse_sse header X-Amz-Server-Side-Encryption *
		error @refuse_sse 403
		@refuse_sse_kms_key header X-Amz-Server-Side-Encryption-Aws-Kms-Key-Id *
		error @refuse_sse_kms_key 403
		@refuse_sse_context header X-Amz-Server-Side-Encryption-Context *
		error @refuse_sse_context 403
		@refuse_sse_c_algorithm header X-Amz-Server-Side-Encryption-Customer-Algorithm *
		error @refuse_sse_c_algorithm 403
		@refuse_sse_c_key header X-Amz-Server-Side-Encryption-Customer-Key *
		error @refuse_sse_c_key 403
		@refuse_sse_c_key_md5 header X-Amz-Server-Side-Encryption-Customer-Key-Md5 *
		error @refuse_sse_c_key_md5 403
		@refuse_sse_bucket_key header X-Amz-Server-Side-Encryption-Bucket-Key-Enabled *
		error @refuse_sse_bucket_key 403
		@refuse_copy_source header X-Amz-Copy-Source *
		error @refuse_copy_source 403
		@refuse_copy_source_range header X-Amz-Copy-Source-Range *
		error @refuse_copy_source_range 403
		@refuse_metadata_directive header X-Amz-Metadata-Directive *
		error @refuse_metadata_directive 403
		@refuse_replication_status header X-Amz-Replication-Status *
		error @refuse_replication_status 403
		@refuse_lock_mode header X-Amz-Object-Lock-Mode *
		error @refuse_lock_mode 403
		@refuse_lock_retain header X-Amz-Object-Lock-Retain-Until-Date *
		error @refuse_lock_retain 403
		@refuse_lock_legal_hold header X-Amz-Object-Lock-Legal-Hold *
		error @refuse_lock_legal_hold 403
		# 1. named refusals — the generic S3 write-side headers no recorded shape sends: object
		#    tagging, canned / explicit ACL grants, storage class, website redirect, an STS session
		#    token and the governance-retention bypass (BR-2, "the list only ever grows")
		@refuse_tagging header X-Amz-Tagging *
		error @refuse_tagging 403
		@refuse_tagging_directive header X-Amz-Tagging-Directive *
		error @refuse_tagging_directive 403
		@refuse_acl header X-Amz-Acl *
		error @refuse_acl 403
		@refuse_grant_read header X-Amz-Grant-Read *
		error @refuse_grant_read 403
		@refuse_grant_write header X-Amz-Grant-Write *
		error @refuse_grant_write 403
		@refuse_grant_read_acp header X-Amz-Grant-Read-Acp *
		error @refuse_grant_read_acp 403
		@refuse_grant_write_acp header X-Amz-Grant-Write-Acp *
		error @refuse_grant_write_acp 403
		@refuse_grant_full_control header X-Amz-Grant-Full-Control *
		error @refuse_grant_full_control 403
		@refuse_storage_class header X-Amz-Storage-Class *
		error @refuse_storage_class 403
		@refuse_website_redirect header X-Amz-Website-Redirect-Location *
		error @refuse_website_redirect 403
		@refuse_security_token header X-Amz-Security-Token *
		error @refuse_security_token 403
		@refuse_bypass_governance header X-Amz-Bypass-Governance-Retention *
		error @refuse_bypass_governance 403
		# 1. named refusals — MinIO's internal, source and replication headers (BR-2)
		@refuse_minio_src_repl_request header X-Minio-Source-Replication-Request *
		error @refuse_minio_src_repl_request 403
		@refuse_minio_src_repl_check header X-Minio-Source-Replication-Check *
		error @refuse_minio_src_repl_check 403
		@refuse_minio_src_repl_retention header X-Minio-Source-Replication-Retention-Timestamp *
		error @refuse_minio_src_repl_retention 403
		@refuse_minio_src_repl_legalhold header X-Minio-Source-Replication-Legalhold-Timestamp *
		error @refuse_minio_src_repl_legalhold 403
		@refuse_minio_src_repl_tagging header X-Minio-Source-Replication-Tagging-Timestamp *
		error @refuse_minio_src_repl_tagging 403
		@refuse_minio_src_proxy header X-Minio-Source-Proxy-Request *
		error @refuse_minio_src_proxy 403
		@refuse_minio_src_mtime header X-Minio-Source-Mtime *
		error @refuse_minio_src_mtime 403
		@refuse_minio_src_etag header X-Minio-Source-Etag *
		error @refuse_minio_src_etag 403
		@refuse_minio_src_deletemarker header X-Minio-Source-Deletemarker *
		error @refuse_minio_src_deletemarker 403
		@refuse_minio_repl_sealed_key header X-Minio-Replication-Server-Side-Encryption-Sealed-Key *
		error @refuse_minio_repl_sealed_key 403
		@refuse_minio_repl_seal_algorithm header X-Minio-Replication-Server-Side-Encryption-Seal-Algorithm *
		error @refuse_minio_repl_seal_algorithm 403
		@refuse_minio_repl_iv header X-Minio-Replication-Server-Side-Encryption-Iv *
		error @refuse_minio_repl_iv 403
		@refuse_minio_repl_actual_size header X-Minio-Replication-Actual-Object-Size *
		error @refuse_minio_repl_actual_size 403
		@refuse_minio_repl_reset header X-Minio-Replication-Reset-Status *
		error @refuse_minio_repl_reset 403
		@refuse_minio_repl_ssec_crc header X-Minio-Replication-Ssec-Crc *
		error @refuse_minio_repl_ssec_crc 403
		@refuse_minio_repl_delete_status header X-Minio-Replication-Delete-Status *
		error @refuse_minio_repl_delete_status 403
		@refuse_minio_repl_deletemarker_status header X-Minio-Replication-Deletemarker-Status *
		error @refuse_minio_repl_deletemarker_status 403
		@refuse_minio_repl_encrypted_multipart header X-Minio-Replication-Encrypted-Multipart *
		error @refuse_minio_repl_encrypted_multipart 403
		@refuse_minio_repl_ready header X-Minio-Replication-Ready *
		error @refuse_minio_repl_ready 403
		@refuse_minio_check_repl_ready header X-Minio-Check-Replication-Ready *
		error @refuse_minio_check_repl_ready 403
		@refuse_minio_force_delete header X-Minio-Force-Delete *
		error @refuse_minio_force_delete 403
		@refuse_minio_force_create header X-Minio-Force-Create *
		error @refuse_minio_force_create 403
		@refuse_minio_extract header X-Minio-Extract *
		error @refuse_minio_extract 403
		@refuse_minio_fanout header X-Minio-Fanout-List *
		error @refuse_minio_fanout 403
		# 2. the positive allowlist (BR-3, BR-4, BR-6) — method ∈ {GET, HEAD, PUT, OPTIONS} AND the
		#    raw URI is one object key in one of the three minted shapes with an all-presigned
		#    query (or none). Anything else is refused. Keep this expression and check 11 of
		#    check-caddyfile.sh in step: the check asserts it VERBATIM (a dropped anchor or a
		#    widened class fails `make quality`; a deliberate change edits both files in the same
		#    commit), the rehearsal probes (scripts/tests/storage-perimeter.test.sh) prove what it
		#    refuses and passes.
		@not_allowlisted not expression `method('GET', 'HEAD', 'PUT', 'OPTIONS') && {http.request.uri}.matches('^(/media-public/public/[0-9a-f-]{36}/[0-9a-f-]{36}/[a-z_]+\\.[a-z0-9]+|/media-public/public/[0-9a-f-]{36}/[a-z_]+\\.[a-z0-9]+|/media-private/private/[0-9a-f-]{36}/[0-9a-f-]{36}/[a-z_]+\\.[a-z0-9]+)(\\?((?i:x-amz-(algorithm|credential|date|expires|signedheaders|signature))=[A-Za-z0-9%._~-]*|(?i:x-amz-content-sha256)=UNSIGNED-PAYLOAD|(?i:x-amz-meta-asset-id)=[0-9a-f-]{36})(&((?i:x-amz-(algorithm|credential|date|expires|signedheaders|signature))=[A-Za-z0-9%._~-]*|(?i:x-amz-content-sha256)=UNSIGNED-PAYLOAD|(?i:x-amz-meta-asset-id)=[0-9a-f-]{36}))*)?$')`
		error @not_allowlisted 403
		# 3. the family strip — an unnamed member of a refused family never reaches MinIO
		request_header -X-Minio-*
		request_header -X-Amz-Meta-Snowball*
		request_header -X-Amz-Meta-Minio-*
		request_header -X-Amz-Server-Side-Encryption*
		request_header -X-Amz-Copy-Source*
		request_header -X-Amz-Replication*
		request_header -X-Amz-Object-Lock*
		request_header -X-Amz-Grant-*
		request_header -X-Amz-Tagging*
		# 4. the store
		reverse_proxy storage:9000
	}
	import error_lane
}

# ---- the stage-1 captured-mail viewer — behind basic auth (BR-25, BR-18) ----
# Mailpit's own UI emits no security headers; the floor's deferred defaults are
# therefore the writer here too (the one upstream where the "no-op by
# construction" above does not hold — accepted: the viewer ends at 10.9).
mail.{$DOMAIN} {
	tls {$CADDY_TLS_ARG}
	encode zstd gzip
	import access-log
	import security_floor
	header X-Robots-Tag "noindex"
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	reverse_proxy mailpit:8025
	import error_lane
}
