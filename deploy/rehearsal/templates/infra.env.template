# The three INFRASTRUCTURE env files docker-compose.prod.yml reads beside app.env / media.env.
# They carry only infrastructure credentials (never an application key), one block per file;
# rehearse.sh splits this template into postgres.env / storage.env / mercure.env in the scratch
# secrets dir, generating every @generate value. In production 10.6 materialises the same three
# files at /srv/trades/secrets/ from the parameter store.

[postgres.env]
POSTGRES_USER=trades
POSTGRES_PASSWORD=@generate:hex32
POSTGRES_DB=trades_app

[storage.env]
MINIO_ROOT_USER=trades-storage
MINIO_ROOT_PASSWORD=@generate:hex32

[mercure.env]
# MUST equal app.env's MERCURE_JWT_SECRET / MERCURE_SUBSCRIBER_JWT_KEY — rehearse.sh copies the
# generated values; production rotation changes both files together (RUNBOOK.md § Rotate).
MERCURE_PUBLISHER_JWT_KEY=@from:app.env:MERCURE_JWT_SECRET
MERCURE_SUBSCRIBER_JWT_KEY=@from:app.env:MERCURE_SUBSCRIBER_JWT_KEY
