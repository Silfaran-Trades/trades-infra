# Rehearsal overrides for /srv/trades/secrets/app.env (trades-backend).
#
# rehearse.sh builds the scratch app.env from EVERY key of trades-backend/.env.example (so the
# AC-13 completeness check has the same key set on both sides), in this order of precedence:
#   1. a line here                       — the rehearsal's value (URLs, paths, modes);
#   2. a `.env.example` value of CHANGE_ME — replaced by a generated random secret;
#   3. the `.env.example` value           — kept as is.
# Lines whose value is `@generate` are ALSO generated (for keys whose example value is not
# CHANGE_ME but must be unique per environment). `@generate:hex32` / `@generate:hex64` pick
# the length.
#
# NOTHING IN THIS FILE IS A SECRET — every secret is generated at rehearsal time into the
# gitignored scratch tree. Keys the Backend Developer phase adds to .env.example (BR-29/BR-30)
# are listed here too so the scratch file carries them the moment .env.example does.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=@generate:hex32
DATABASE_URL=postgresql://trades:@POSTGRES_PASSWORD@@postgres:5432/trades_app?serverVersion=18
CORS_ALLOW_ORIGIN=^https://app\.@DOMAIN@$
APP_FRONTEND_URL=https://app.@DOMAIN@
JWT_SECRET_KEY=/run/secrets/files/jwt-private.pem
JWT_PUBLIC_KEY=/run/secrets/files/jwt-public.pem
JWT_PASSPHRASE=@generate:hex32
OAUTH_GOOGLE_REDIRECT_URI=https://api.@DOMAIN@/api/oauth/google/callback
DUMMY_PASSWORD_HASH_FILE=/run/secrets/files/dummy-password-hash.txt
FCM_CREDENTIALS_FILE=/run/secrets/files/fcm-credentials.json
FCM_PROJECT_ID=trades-rehearsal
# Stage-1 mail capture (BR-25): every message lands in the mailpit service of
# docker-compose.prod.yml and nothing leaves the host; the viewer is mail.@DOMAIN@ (AC-7).
MAILER_DSN=smtp://mailpit:1025
MEDIA_SERVICE_BASE_URL=http://media:8008
PUBLIC_ASSET_BUCKET_BASE_URL=https://storage.@DOMAIN@/media-public
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=https://api.@DOMAIN@/.well-known/mercure
MERCURE_JWT_SECRET=@generate:hex64
MERCURE_SUBSCRIBER_JWT_KEY=@generate:hex64
# Perimeter keys (BR-29, BR-30 — added to .env.example by the Backend Developer phase).
TRUSTED_PROXIES=@SUBNET@
CSRF_REFRESH_COOKIE_DOMAIN=@DOMAIN@
# Every *.sslip.io host is same-site with this project's hosts, so the refresh endpoint must
# require the double-submit header (10.6 BR-26b, TM-6) — the rehearsal runs the same value.
CSRF_REFRESH_ENFORCEMENT=true
