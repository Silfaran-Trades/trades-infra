# Rehearsal overrides for /srv/trades/secrets/media.env (media-service). Same rules as
# app.env.overrides: every key of media-service/.env.example, overridden here where the
# rehearsal needs its own value, generated where the example says CHANGE_ME or `@generate`.
# Nothing here is a secret.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=@generate:hex32
DATABASE_URL=postgresql://trades:@POSTGRES_PASSWORD@@postgres:5432/media?serverVersion=18
CORS_ALLOW_ORIGIN=^https://app\.@DOMAIN@$
JWT_PUBLIC_KEY=/run/secrets/files/jwt-public.pem
MEDIA_PUBLIC_BUCKET=media-public
MEDIA_PRIVATE_BUCKET=media-private
# The two least-privilege MinIO identities (ADR-135, minio-storage-perimeter-hardening) — NEVER
# the root pair. The DSN carries the SERVICE identity (media-service's own server-side work);
# the two PRESIGN lines feed the signing client only. Both secrets are the values rehearse.sh
# generated into the scratch storage.env, where the `storage-init` bootstrap reads them to
# create the users — one value in two files, like the Mercure keys.
MEDIA_STORAGE_DSN=s3://media-service:@MEDIA_STORAGE_SERVICE_SECRET_KEY@@storage:9000?region=us-east-1&path_style=true
MEDIA_STORAGE_PRESIGN_ACCESS_KEY=media-presign
MEDIA_STORAGE_PRESIGN_SECRET_KEY=@MEDIA_STORAGE_PRESIGN_SECRET_KEY@
MEDIA_STORAGE_PUBLIC_ENDPOINT=https://storage.@DOMAIN@
# ClamAV and the perimeter (added to .env.example by the Backend Developer phase, BR-19/BR-30).
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=2000
CLAMAV_READ_TIMEOUT_MS=30000
CLAMAV_INSTREAM_CHUNK_BYTES=1048576
TRUSTED_PROXIES=@SUBNET@
