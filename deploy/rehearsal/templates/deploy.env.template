# deploy/.env — HOST STATE for docker-compose.prod.yml (gitignored; this template documents it).
#
# Production: /srv/trades/deploy/.env, written by 10.6's first deploy and maintained by
# deploy.sh (the *_TAG lines). Rehearsal: rehearse.sh writes deploy/rehearsal/.scratch/deploy/.env
# from this template with the values marked [rehearsal].
#
# NO SECRET GOES HERE — this file only carries names, tags and switches.

# The base hostname: `terraform output public_hostname` (<eip-with-dashes>.sslip.io, BR-15) in
# stage 1, the real domain at 10.9. One hostname per deployable hangs off it:
# app.  api.  media.  storage.  mail.                              [rehearsal: trades.test]
DOMAIN=example.com

# Caddy's `tls` argument: the ACME registration e-mail in production (Let's Encrypt, with the
# ZeroSSL fallback it enables — BR-16), `internal` for the rehearsal's local CA. [rehearsal: internal]
CADDY_TLS_ARG=ops@example.com

# The ECR registry host: `terraform output registry` (<account>.dkr.ecr.eu-south-2.amazonaws.com,
# BR-23). Every image reference in the compose is ${REGISTRY}/trades/<name>.
#                                                     [rehearsal: rehearsal.invalid]
REGISTRY=123456789012.dkr.ecr.eu-south-2.amazonaws.com

# The stage-1 perimeter credential (BR-18, BR-19): basic auth on app. and mail. The hash comes
# from `docker run --rm caddy:2.11 caddy hash-password` and MUST be SINGLE-QUOTED — Compose
# interpolates an unquoted `$` and silently corrupts a bcrypt hash; verify with
# `docker compose config | grep BASIC_AUTH_HASH` before the first start (RUNBOOK.md). The
# password itself lives only in the developer's password manager. The dummy below is a hash of
# a throwaway string, never a credential.                     [rehearsal: generated per run]
BASIC_AUTH_USER=partner
BASIC_AUTH_HASH='$2a$14$LsHR11mll7TvrahydNFt1.2QgeQ2goSA74PzRz8e5B3DTjNSd4/Rq'

# The off-host backups bucket: `terraform output backups_bucket` (BR-28). Read by deploy.sh
# (for the inline DE-005 backup) and backup-postgres.sh — not interpolated by compose.
#                                                     [rehearsal: unset — REHEARSAL_NO_OFFHOST_COPY=1]
BACKUPS_BUCKET=trades-production-backups-123456789012

# Where the per-service env files and the file-shaped secrets live.
#                                                     [rehearsal: <scratch>/secrets]
TRADES_SECRETS_DIR=/srv/trades/secrets

# The fixed internal subnet — MUST equal TRUSTED_PROXIES in app.env and media.env (BR-30).
TRADES_PROD_SUBNET=172.30.0.0/24

# The three deployable tags: FULL 40-char git SHAs, written by deploy.sh — never by hand,
# never `latest`. `bootstrap-pending` is the unpromotable first-boot sentinel deploy.sh seeds
# for siblings that have not deployed yet.
APP_TAG=bootstrap-pending
MEDIA_TAG=bootstrap-pending
WEB_TAG=bootstrap-pending
