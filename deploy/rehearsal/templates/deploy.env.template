# deploy/.env — HOST STATE for docker-compose.prod.yml (gitignored; this template documents it).
#
# Production: /srv/trades/deploy/.env, written by 10.6's first deploy and maintained by
# deploy.sh (the *_TAG lines). Rehearsal: rehearse.sh writes deploy/rehearsal/.scratch/deploy/.env
# from this template with the values marked [rehearsal].
#
# NO SECRET GOES HERE — this file only carries names, tags and switches.

# The production domain (10.6's decision). One hostname per deployable hangs off it:
# app.  api.  media.  storage.                                     [rehearsal: trades.test]
DOMAIN=example.com

# Caddy's `tls` argument: an ACME registration email in production (Let's Encrypt / ZeroSSL
# expiry notices), `internal` for the rehearsal's local CA.       [rehearsal: internal]
CADDY_TLS_ARG=ops@example.com

# Where the per-service env files and the file-shaped secrets live.
#                                                     [rehearsal: <scratch>/secrets]
TRADES_SECRETS_DIR=/srv/trades/secrets

# The fixed internal subnet — MUST equal TRUSTED_PROXIES in app.env and media.env (BR-30).
TRADES_PROD_SUBNET=172.30.0.0/24

# The three deployable tags: FULL 40-char git SHAs, written by deploy.sh — never by hand,
# never `latest`. `bootstrap-pending` is the unpromotable first-boot sentinel deploy.sh seeds
# for siblings that have not deployed yet.
APP_TAG=bootstrap-pending
MEDIA_TAG=bootstrap-pending
WEB_TAG=bootstrap-pending
